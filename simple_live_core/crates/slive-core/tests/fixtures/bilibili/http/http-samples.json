    "passport_qrcode_poll": {
      "endpoint": "https://passport.bilibili.com/x/passport-login/web/qrcode/poll",
      "method": "GET",
      "dart_source": "simple_live_core/lib/src/platforms/bilibili/bilibili_site.dart:576-610",
      "target_ac": [
        "AC-19"
      ],
      "synthetic": true,
      "field_sources": {
        "data.code 映射": "dart:589-608",
        "set-cookie 汇总为 credential": "dart:591-601"
      },
      "response": {
        "code": 0,
        "data": {
          "code": 86038,
          "message": "",
          "url": ""
        }
      },
      "expected": {
        "status": "expired"
      },
      "variants": [
        {
          "desc": "code=0 扫码成功",
          "response": {
            "code": 0,
            "data": {
              "code": 0
            }
          },
          "response_headers": {
            "set-cookie": [
              "SESSDATA=xxx; Path=/; HttpOnly",
              "bili_jct=yyy; Path=/"
            ]
          },
          "expected": {
            "status": "scanned",
            "credential": "{\"cookie\":\"SESSDATA=xxx;bili_jct=yyy\"}"
          }
        },
        {
          "desc": "code=86090 已扫码未确认",
          "response": {
            "code": 0,
            "data": {
              "code": 86090
            }
          },
          "expected": {
            "status": "scanned",
            "credential": ""
          }
        },
        {
          "desc": "其它 code 保持未扫",
          "response": {
            "code": 0,
            "data": {
              "code": 86101
            }
          },
          "expected": {
            "status": "unscanned",
            "credential": ""
          }
        }
      ],
      "verify_note": "本文件 headers 需另附 `set-cookie`（HTTP 响应头，非 body），Dart 汇总为 JSON `{\"cookie\":...}`；code 0→scanned+credential、86038→expired、86090→scanned、其余→unscanned（AC-19 全覆盖）。注意：Dart dart:598 曾 `CoreLog.i(cookieStr)` 打印 cookie 明文——Rust 侧**禁止**复刻（AC-40）。"
    },
