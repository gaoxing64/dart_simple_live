// Slive 系统上下文（L1，当前状态，2026-10-28）
// 证据：README.md、simple_live_app/lib/main.dart、simple_live_app/lib/services/*
// 渲染：dot -Tsvg system-context.dot -o system-context.svg
digraph slive_context {
  graph [
    rankdir=TB,
    fontname="Microsoft YaHei",
    fontsize=12,
    labelloc=t,
    label="Slive 系统上下文（当前状态）\n证据强度：高（代码/依赖清单直接可证）",
    nodesep=0.6,
    ranksep=0.8,
    pad=0.3
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="Microsoft YaHei",
    fontsize=10,
    color="#5F6368",
    penwidth=1.2
  ];
  edge [
    fontname="Microsoft YaHei",
    fontsize=9,
    color="#5F6368",
    arrowsize=0.7
  ];

  viewer [
    label="观众 / 用户\n（移动端、桌面、电视）",
    shape=box,
    style="rounded,filled",
    fillcolor="#E8F0FE"
  ];

  slive [
    label="Slive 客户端家族\n\n• simple_live_app（Android / iOS / Windows / Linux / macOS）\n• simple_live_tv_app（Android TV）\n• slive CLI（直连 Rust 核心）",
    fillcolor="#D2E3FC",
    penwidth=2.0
  ];

  platforms [
    label="直播平台（外部）\n哔哩哔哩 / 斗鱼 / 虎牙 / 抖音 / Twitch\nHTTPS API + WSS；斗鱼弹幕走明文 TCP",
    fillcolor="#FFF1E0"
  ];

  firebase [
    label="Firebase（外部）\nAnalytics + Crashlytics\n仅 Android 初始化",
    fillcolor="#FFF1E0"
  ];

  webdav [
    label="WebDAV 服务器（外部）\n用户自建备份目标",
    fillcolor="#FFF1E0"
  ];

  lan [
    label="局域网内其他设备\nUDP 23235 发现 + HTTP 23234 同步",
    fillcolor="#FFF1E0"
  ];

  viewer -> slive [label="观看 / 搜索 / 关注 / 设置"];

  slive -> platforms [
    label="拉取分类·房间详情·播放直链\n订阅弹幕（WSS / TCP）",
    dir=both
  ];

  slive -> firebase [label="埋点与崩溃上报", style=dashed];

  slive -> webdav [
    label="备份 / 恢复（关注、历史、设置、Cookie）",
    dir=both,
    style=dashed
  ];

  slive -> lan [
    label="近场同步 / 遥控",
    dir=both,
    style=dashed
  ];
}
